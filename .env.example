# ============================================================================
# BioCaps Monitor® — Variables de entorno
# Copie este archivo como .env y ajuste los valores antes de desplegar.
#   cp .env.example .env
# ============================================================================

# --------------------------------- Entorno ---------------------------------
NODE_ENV=production

# Puerto interno de la aplicación (dentro del contenedor).
PORT=3000

# Puerto publicado en la máquina anfitriona (sólo lo usa docker-compose).
BIOCAPS_PUERTO=8090

# Zona horaria del contenedor: afecta a las fechas registradas.
TZ=America/Guayaquil

# ------------------------------ URL pública ------------------------------
# Dominio por el que los usuarios acceden. Se incrusta en los códigos QR de
# los reportes técnicos, así que debe ser la URL real y accesible.
BIOCAPS_URL=https://monitor.biocaps.ec

# --------------------------------- Seguridad ---------------------------------
# OBLIGATORIO en producción. Firma los tokens de sesión: si cambia, todas las
# sesiones abiertas se invalidan. Genérelo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BIOCAPS_SECRET=cambie-esto-por-un-valor-aleatorio-de-al-menos-64-caracteres

# Duración de la sesión en horas.
BIOCAPS_SESION_HORAS=12

# Longitud mínima de contraseña.
BIOCAPS_PASSWORD_MIN=8

# La aplicación está detrás de un proxy inverso (Nginx, Traefik, Caddy).
BIOCAPS_TRAS_PROXY=true

# Enviar la cookie de sesión sólo por HTTPS. Actívelo cuando tenga certificado;
# si lo activa sin HTTPS, nadie podrá iniciar sesión.
BIOCAPS_COOKIE_SEGURA=false

# ------------------------------ Registro de cuentas ------------------------------
# Permite que una organización cree su propia cuenta desde la pantalla de acceso.
BIOCAPS_REGISTRO_PUBLICO=true

# Si es true, las cuentas nuevas quedan inactivas hasta que un administrador
# las habilita desde Configuración › Usuarios.
BIOCAPS_REGISTRO_APROBACION=false

# --------------------------------- Datos ---------------------------------
# Rutas de datos persistentes. En Docker son volúmenes; no las cambie salvo que
# también ajuste docker-compose.yml.
BIOCAPS_DATA_DIR=/datos
BIOCAPS_UPLOADS_DIR=/subidas

# Tamaño máximo de archivo subido, en MB.
BIOCAPS_MAX_ARCHIVO_MB=8

# Cargar los datos de demostración al arrancar si la base está vacía.
# Déjelo en false para un despliegue real.
BIOCAPS_SEMILLA_AUTO=false
